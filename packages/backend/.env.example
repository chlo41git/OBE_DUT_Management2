# 資料庫連線 —— 本機 PostgreSQL（由 pgAdmin 4 建立與管理）
#
# 建立步驟見 docs/DATABASE_SETUP.md：
#   1. pgAdmin 4 以 postgres 連線 → Query Tool 執行
#      packages/backend/prisma/sql/01_create_role.sql   （建立 obe 帳號）
#   2. Databases 右鍵 → Create → Database…
#      Database = obe_dut_v04、Owner = obe
#   3. npm run db:check   （自檢連線／權限／migration 狀態）
#
# 格式：postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
# 若密碼含 @ : / ? # 等字元，需做 percent-encoding。
DATABASE_URL="postgresql://obe:CHANGE_ME@localhost:5432/obe_dut_v04?schema=public"

PORT=4000
CORS_ORIGIN="http://localhost:5173"
